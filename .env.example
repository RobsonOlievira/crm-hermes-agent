# ============================================
# VARIÁVEIS DE AMBIENTE - CRM Whitelabel
# ============================================
# Copie este arquivo para .env e preencha os valores.
#   cp .env.example .env

# --- Banco de Dados (PostgreSQL) ---
# URL de conexão com seu banco PostgreSQL.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
# Exemplos de serviços gratuitos: Neon (neon.tech), Supabase, Railway, PlanetScale
DATABASE_URL="postgresql://usuario:senha@localhost:5432/crm_whitelabel"

# --- Autenticação (NextAuth) ---
# Gere uma chave secreta aleatória. No terminal, rode:
#   openssl rand -base64 32
NEXTAUTH_SECRET="cole_aqui_uma_chave_aleatoria"

# URL onde o app vai rodar (mude para a URL de produção ao fazer deploy)
NEXTAUTH_URL="http://localhost:3000"

# --- Email Marketing (Resend) ---
# Preencha com sua chave do Resend (https://resend.com) e um remetente verificado.
RESEND_API_KEY="sua_resend_api_key"
EMAIL_FROM="NexusCRM <onboarding@resend.dev>"
EMAIL_REPLY_TO="onboarding@resend.dev"

# --- Armazenamento de Arquivos (S3 - OPCIONAL) ---
# Só precisa configurar se for usar upload de arquivos.
# Funciona com AWS S3, MinIO, DigitalOcean Spaces, etc.
# AWS_REGION="us-east-1"
# AWS_BUCKET_NAME="nome-do-seu-bucket"
# AWS_FOLDER_PREFIX="crm/"
# AWS_ACCESS_KEY_ID="sua_access_key"
# AWS_SECRET_ACCESS_KEY="sua_secret_key"
